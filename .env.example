# ==============================================================================
# PLANTILLA MAESTRA PARA RESTAURANTES - PANDA HAUS
# ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env)
# ==============================================================================
# Copia este archivo como .env.local para desarrollo local, y copia estas mismas
# variables en los "Environment Variables" del panel del proyecto en Vercel.
# ==============================================================================

# 1. Base de Datos MongoDB (MongoDB Atlas recomendado para Serverless en Vercel)
# Obtén tu cadena de conexión gratuita en: https://cloud.mongodb.com
# Ejemplo: mongodb+srv://usuario:password@cluster0.abcde.mongodb.net/restaurante-db?retryWrites=true&w=majority
MONGODB_URI=

# 2. Clave Secreta de Payload CMS (Secreto criptográfico para JWT y sesiones del CMS)
# Genera una cadena aleatoria segura (ejemplo con openssl rand -hex 32)
PAYLOAD_SECRET=

# 3. URL Pública del Servidor
# En desarrollo local: http://localhost:3000
# En producción (Vercel): https://tu-dominio-restaurante.vercel.app (o dominio personalizado)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# 4. Datos por Defecto del Restaurante (Opcionales si aún no conectas MongoDB)
# Se usan como fallback dinámico para previsualización inmediata
NEXT_PUBLIC_RESTAURANT_NAME="Panda Arepas & Grill"
NEXT_PUBLIC_WHATSAPP_PHONE="573001234567"

# 5. Cloudinary (Almacenamiento persistente de imágenes para Vercel Serverless)
# Permite que las imágenes subidas al CMS nunca se borren en Vercel
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
